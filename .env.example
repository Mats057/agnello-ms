# Local Docker Compose configuration. Copy to .env before starting the stack.
JWT_SECRET=replace-with-a-long-local-secret
ESTOQUE_URL=http://estoque-service:8080
MENSAGERIA_URL=http://mensageria-service:8080
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=vinheria
RABBITMQ_PASSWORD=replace-with-a-rabbitmq-password
ALLOW_SELF_SIGNED_CERT=false
CERT_PASSWORD=replace-with-the-certificate-password
